<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI Toolkit/Panel/PanelStyle.uss" />
    
    <MarkerPanelController class="root-container">
        <ui:VisualElement name="Marker" class="marker-base">
            <ui:VisualElement class="marker-dot" />
        </ui:VisualElement>

        <ui:VisualElement name="InfoPanel" class="panel-container">
            <ui:Label text="THÔNG TIN HỆ THỐNG" class="header-title" />
            <ui:VisualElement class="header-line" />
            <ui:Label text="Trạng thái: Đang kết nối..." class="description-text" />
            
            <ui:VisualElement class="panel-footer">
                <ui:Button text="ĐÓNG" name="BtnClose" class="btn-secondary" />
                <ui:Button text="XÁC NHẬN" class="btn-primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </MarkerPanelController>
</ui:UXML>